# Modo público seguro: não consulta Supabase, Gmail, Hotmart ou qualquer API.
PORTFOLIO_DEMO_MODE=true

# As variáveis abaixo permanecem vazias na demo pública.
# Use somente com um projeto Supabase isolado e nunca com produção.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOMENTE NO SERVIDOR. NUNCA use NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=

# E-mails autorizados a entrar no dashboard, separados por vírgula.
# Ex.: portfolio.demo@example.com,reviewer.demo@example.com
DASHBOARD_ALLOWED_EMAILS=portfolio.demo@example.com

# Fuso usado nos gráficos por dia
APP_TIMEZONE=America/Sao_Paulo
